find_package(Git REQUIRED)
function(benchmark_git)
  execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN} RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Could not obtain the public raisim2Lib SDK (git exit ${status}).")
  endif()
endfunction()
if(BENCHMARK_SDK_SOURCE_DIR)
  get_filename_component(BENCHMARK_SDK_SOURCE_DIR "${BENCHMARK_SDK_SOURCE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
endif()
if(NOT BENCHMARK_SDK_SOURCE_DIR)
  set(BENCHMARK_SDK_SOURCE_DIR "${CMAKE_BINARY_DIR}/_deps/raisim2Lib")
  if(NOT EXISTS "${BENCHMARK_SDK_SOURCE_DIR}/.git")
    benchmark_git(clone --depth 1 --filter=blob:none --sparse --no-checkout
      https://github.com/raisimTech/raisim2Lib.git "${BENCHMARK_SDK_SOURCE_DIR}")
    benchmark_git(-C "${BENCHMARK_SDK_SOURCE_DIR}" sparse-checkout set cmake thirdParty/Eigen3 rsc/anymal rsc/strandbeest)
    benchmark_git(-C "${BENCHMARK_SDK_SOURCE_DIR}" fetch --depth 1 origin "${BENCHMARK_SDK_REVISION}")
    benchmark_git(-C "${BENCHMARK_SDK_SOURCE_DIR}" checkout --detach "${BENCHMARK_SDK_REVISION}")
  else()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${BENCHMARK_SDK_SOURCE_DIR}" rev-parse HEAD OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT revision STREQUAL BENCHMARK_SDK_REVISION)
      message(FATAL_ERROR "SDK revision changed. Use a new build directory for another revision.")
    endif()
  endif()
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${BENCHMARK_SDK_SOURCE_DIR}" rev-parse --show-toplevel
  RESULT_VARIABLE root_status OUTPUT_VARIABLE sdk_git_root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
file(REAL_PATH "${BENCHMARK_SDK_SOURCE_DIR}" sdk_real_path)
if(NOT root_status EQUAL 0)
  message(FATAL_ERROR "The SDK path must be a public raisim2Lib Git checkout root.")
endif()
file(REAL_PATH "${sdk_git_root}" sdk_git_real_path)
if(NOT sdk_real_path STREQUAL sdk_git_real_path)
  message(FATAL_ERROR "The SDK path must be a public raisim2Lib Git checkout root.")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${BENCHMARK_SDK_SOURCE_DIR}" rev-parse HEAD
  RESULT_VARIABLE revision_status OUTPUT_VARIABLE BENCHMARK_SDK_ACTUAL_REVISION
  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT revision_status EQUAL 0)
  message(FATAL_ERROR "Cannot read the SDK checkout commit.")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${BENCHMARK_SDK_SOURCE_DIR}" status --porcelain --untracked-files=no
  RESULT_VARIABLE status_status OUTPUT_VARIABLE sdk_tracked_changes ERROR_QUIET)
if(NOT status_status EQUAL 0)
  message(FATAL_ERROR "Cannot read the SDK checkout state.")
endif()
if(sdk_tracked_changes)
  set(BENCHMARK_SDK_DIRTY true)
else()
  set(BENCHMARK_SDK_DIRTY false)
endif()
if(NOT EXISTS "${BENCHMARK_SDK_SOURCE_DIR}/CMakeLists.txt")
  message(FATAL_ERROR "BENCHMARK_SDK_SOURCE_DIR must point to the public raisim2Lib checkout.")
endif()
file(READ "${BENCHMARK_SDK_SOURCE_DIR}/CMakeLists.txt" sdk_bootstrap)
if(NOT sdk_bootstrap MATCHES "_raisim_download_release")
  message(FATAL_ERROR "This is not the public prebuilt-SDK bootstrap checkout.")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${BENCHMARK_SDK_SOURCE_DIR}" -B "${CMAKE_BINARY_DIR}/sdk-bootstrap"
  -DRAISIM_EXAMPLE=OFF -DRAISIM_PY=OFF -DRAISIM_DOC=OFF -DRAISIM_MATLAB=OFF
  "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}" RESULT_VARIABLE sdk_status)
if(NOT sdk_status EQUAL 0)
  message(FATAL_ERROR "Public SDK setup failed. Check its prebuilt-release download diagnostics above.")
endif()
set(BENCHMARK_SDK_PREFIX "${BENCHMARK_SDK_SOURCE_DIR}/raisim")
if(NOT EXISTS "${BENCHMARK_SDK_PREFIX}/lib/cmake/raisim/raisimConfig.cmake")
  file(GLOB candidates "${BENCHMARK_SDK_SOURCE_DIR}/raisim/*/lib/cmake/raisim/raisimConfig.cmake")
  list(LENGTH candidates candidate_count)
  if(NOT candidate_count EQUAL 1)
    message(FATAL_ERROR "Cannot select exactly one SDK package. Remove unrelated platform packages.")
  endif()
  list(GET candidates 0 config)
  get_filename_component(BENCHMARK_SDK_PREFIX "${config}/../../../.." ABSOLUTE)
endif()
